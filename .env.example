# Set SITE_URL in the hosting platform's build environment once the domain is final.
# Required by npm run build; never use localhost for a production build.
# Build and preview scripts load optional .env.local; hosting environment values take precedence.
# This .env.example file is a template and is never loaded automatically.
SITE_URL=https://www.yourdomain.com
# npm run serve uses http://127.0.0.1:8080 only when SITE_URL is unset.

# Optional browser key for the click-to-load Google Maps Locator Plus component.
# Set in the Cloudflare BUILD environment, then rebuild. Visible in public HTML;
# restrict it to your website referrers and the required Maps APIs in Google Cloud.
GOOGLE_MAPS_API_KEY=
