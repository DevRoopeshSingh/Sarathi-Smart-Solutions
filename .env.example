# Set SITE_URL in the hosting platform's build environment once the domain is final.
# Required by npm run build; never use localhost for a production build.
# This static Node project reads process.env; it does not automatically load .env files.
SITE_URL=https://www.yourdomain.com
# npm run serve uses http://127.0.0.1:8080 only when SITE_URL is unset.
