{
  "name": "sarathi-operations",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "admin:provision": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/provision-admin.ts",
    "admin:recover": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/recover-admin.ts",
    "migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
