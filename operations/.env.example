# Copy to .env.local for local development only. Supply your own values.
DATABASE_URL=
# Generate at least 32 random bytes; never reuse the example or commit a secret.
BETTER_AUTH_SECRET=
# Exact origin, including scheme and development port. HTTPS required in production.
BETTER_AUTH_URL=http://localhost:3000
# Optional public website link; omit until its real origin is known.
PUBLIC_SITE_URL=
