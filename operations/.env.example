# Copy to .env.local for local development only. Supply your own values.
# Restricted runtime role; use the Supabase transaction pooler on Vercel.
DATABASE_URL=
# Maximum connections per application instance, integer 1–10. Start small.
DB_POOL_MAX=2
# Operator/release environment only: schema owner, direct or session pooler URL.
# Required by the migration command in production; never use transaction pooling.
DATABASE_MIGRATION_URL=
# Generate at least 32 random bytes; never reuse the example or commit a secret.
BETTER_AUTH_SECRET=
# Exact origin, including scheme and development port. HTTPS required in production.
BETTER_AUTH_URL=http://localhost:3000
# Optional public website link; omit until its real origin is known.
PUBLIC_SITE_URL=
